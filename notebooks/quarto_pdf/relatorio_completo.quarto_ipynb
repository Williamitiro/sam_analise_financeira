        "matplotlib.use('Agg')  # [FIX] Force non-interactive backend to avoid WinError 6\n",
        "import matplotlib.pyplot as plt\n",
        "import importlib\n",
        "\n",
        "root_dir = os.path.abspath('../../')\n",
        "if root_dir not in sys.path:\n",
        "    sys.path.append(root_dir)\n",
        "\n",
        "sys.path.append(os.path.join(root_dir, 'notebooks/ypynb/'))\n",
        "sys.path.append(os.path.join(root_dir, 'notebooks/ypynb/celulas/'))\n",
        "\n",
        "# [CRITICAL FIX] Force reload of shared utils to avoid stale cache issues\n",
        "try:\n",
        "    import celula_0_utils\n",
